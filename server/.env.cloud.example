# Cloud deployment configuration. Copy to .env.cloud and adjust.
# DB_* points at a managed Postgres (Neon, RDS, Supabase, …).
DB_HOST=
DB_PORT=5432
DB_NAME=stash
DB_USERNAME=stash
DB_PASSWORD=change-me
# The migration runner needs TLS against managed Postgres. The API and consumer
# negotiate TLS on their own (sslmode=prefer), so this only affects migrate.
DB_SSLMODE=require

SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=

# S3-compatible object storage for files and thumbnails.
S3_BUCKET=
S3_REGION=
# Leave S3_ENDPOINT empty for AWS S3; set it for Cloudflare R2 or MinIO.
S3_ENDPOINT=
# Leave the keys empty to use the host's IAM role / default credential chain.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set to true for path-style addressing (MinIO needs it).
S3_PATH_STYLE=false
