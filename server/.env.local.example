# Local development configuration. Copy to .env.local and adjust.
# GOOGLE_CLIENT_ID needs a real Google OAuth web client ID to sign in
# (docs/google-sign-in.md).
POSTGRES_VERSION=17.2
DB_NAME=events
DB_USERNAME=local-user
DB_PASSWORD=local-password
DB_HOST_PORT=45432
DB_HOST=localhost
SESSION_SECRET=local-dev-secret
GOOGLE_CLIENT_ID=local-dev-client-id
# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
