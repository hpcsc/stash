# Self-hosted deployment configuration. Copy to .env.production and adjust.
# GOOGLE_CLIENT_ID needs a real Google OAuth web client ID (docs/google-sign-in.md),
# with the Tailscale hostname listed in its authorised JavaScript origins.
DB_NAME=stash
DB_USERNAME=stash
DB_PASSWORD=change-me
SESSION_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
# Optional. Comma-separated Google subject IDs whose signed-in session gets the
# all-stream scope in the event browser (docs/event-browser.md).
EVENT_BROWSER_USER_IDS=
