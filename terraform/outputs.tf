output "instance_public_ip" {
  description = "Public IP of the VM that runs the containers."
  value       = oci_core_instance.vm.public_ip
}

output "ssh_private_key" {
  description = "SSH private key for the VM (generated by Terraform)."
  value       = tls_private_key.ssh.private_key_openssh
  sensitive   = true
}

output "db_host" {
  description = "Neon database host."
  value       = neon_project.main.database_host
}

output "db_name" {
  description = "Neon database name."
  value       = neon_project.main.database_name
}

output "db_user" {
  description = "Neon database user."
  value       = neon_project.main.database_user
}

output "db_password" {
  description = "Neon database password."
  value       = neon_project.main.database_password
  sensitive   = true
}

output "r2_endpoint" {
  description = "R2 S3-compatible endpoint."
  value       = "https://${var.cloudflare_account_id}.r2.cloudflarestorage.com"
}

output "r2_bucket" {
  description = "R2 bucket name."
  value       = cloudflare_r2_bucket.files.name
}
