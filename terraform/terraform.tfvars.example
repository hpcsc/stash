# Copy to terraform.tfvars and fill in the real values. Never commit terraform.tfvars.
project_name = "stash"

gcp_project_id = "your-project-id"
gcp_sa_key     = file("key.json")             # or paste the JSON directly
gcp_region     = "us-central1"                # us-west1, us-central1, or us-east1 (Always Free)
gcp_zone       = "us-central1-a"
instance_type  = "e2-micro"

neon_org_id    = "org-xxxx-xxxx"
neon_api_key   = "your-neon-api-key"
neon_region_id = "aws-us-east-1"

cloudflare_account_id  = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
cloudflare_api_token    = "your-cloudflare-api-token"
r2_bucket_name         = "stash"

# Custom domain (optional). Set `domain` to an existing Cloudflare zone to serve
# the app at <app_subdomain>.<domain> through a named tunnel instead of the
# ephemeral *.trycloudflare.com quick tunnel. Leave `app_subdomain` empty to use
# the apex domain itself (e.g. domain = "stash.link", app_subdomain = "").
domain         = "example.com"
app_subdomain  = "stash"
