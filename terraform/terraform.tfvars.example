# Copy to terraform.tfvars and fill in the real values. Never commit terraform.tfvars.
project_name = "stash"

gcp_project_id = "your-project-id"
gcp_region     = "us-central1" # us-west1, us-central1, or us-east1 (Always Free)
gcp_zone       = "us-central1-a"
instance_type  = "e2-micro"

neon_org_id    = "org-xxxx-xxxx"
neon_region_id = "aws-us-east-1"

cloudflare_account_id = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
r2_bucket_name        = "stash"
